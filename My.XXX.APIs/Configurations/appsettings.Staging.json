{
  "AppConfig": {
    "EnableRequestLog": false,
    "RequestLogStorageType": 1, /*1:Text,2:SQL*/
    "ExceptionStorageType": 1, /*1:Text,2:SQL,3:Email*/
    "ExceptionEmail": {
      "MailFrom": "forres.jiang@cn.xxx.com",
      "MailTo": "forres.jiang@cn.xxx.com"
    },
    "PermissionDataCache": 0
  },
  "PermissionWhitelist": {
    "Controllers": [ "demo" ],
    "Actions": [ "user/Login", "user/LoginUrl", "user/RefreshToken" ]
  },
  "RedisConfig": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "JwtConfig": {
    "Secret": "",
    "Issuer": "My.XXX.API",
    "Audience": "XXX",
    "ExpiryInMinutes": 20,
    "RefreshExpiryInMinutes": 43200
  },
  "ConnectionStrings": {
    "Default": "",
    "MailMaster": ""
  },
  "AllowedHostArray": [
    "http://localhost:8080",
    "http://localhost:8081",
    "http://localhost:9000"
  ],
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": { "Default": "Debug" },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/.txt",
          "rollingInterval": "Day",
          "RestrictedToMinimumLevel": "Warning",
          "retainedFileCountLimit": "90"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "xxx"
    }
  }
}