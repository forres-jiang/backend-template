{
  "AppConfig": {
    "EnableRequestLog": true,
    "RequestLogStorageType": 1, /*1:Text,2:SQL*/
    "ExceptionStorageType": 1, /*1:Text,2:SQL,3:Email*/
    "ExceptionEmail": {
      "MailFrom": "forres.jiang@cn.pwc.com",
      "MailTo": "forres.jiang@cn.pwc.com"
    },
    "PermissionDataCache": 0 /*1:Redis,0:DB*/
  },
  "AppCenterConfig": {
    "UserInfoAPI": "https://cnshaappuwv751.asia.pwcinternal.com/AppCenterAPIs/",
    "LoginUrl": "https://cnshaappuwv751.asia.pwcinternal.com/OpenDJ/Account/uatLogin",
    "AppCode": "xxx",
    "AppSecret": "",
    "TokenExpireTime": 1 /*day*/
  },
  "PermissionWhitelist": {
    "Controllers": [ "demo" ], /*Action权限白名单,根据实际情况配置,支持登录后免权限校验的接口*/
    "Actions": [ "user/Login", "user/LoginUrl", "user/RefreshToken" ]
  },
  "RedisConfig": {
    /*Rancher内部调用Redis的地址和端口 fcs-redis-service.commoncache.svc.cluster.local:6379*/
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "JwtConfig": {
    "Secret": "",
    "Issuer": "My.XXX.API",
    "Audience": "XXX",
    "ExpiryInMinutes": 20, /*token过期时间*/
    "RefreshExpiryInMinutes": 43200
  },
  "ConnectionStrings": {
    "Default": "",
    "MailMaster": ""
  },
  "AllowedHostArray": [
    "http://localhost:8080",
    "http://localhost:8081",
    "http://localhost:9000",
    "http://localhost:9001",
    "http://localhost:9002",
    "https://tdhpro.asia.pwcinternal.com"
  ],
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": { "Default": "Debug" },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/.txt",
          "rollingInterval": "Day",
          "RestrictedToMinimumLevel": "Warning",
          "retainedFileCountLimit": "90"
        }
      }
      /*{  "Name": "EventCollector",
        "Args": {
          "splunkHost": "http://cncutmulv5005:8088",
          "eventCollectorToken": ""
        }
      }*/
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "xxx"
    }
  }
}